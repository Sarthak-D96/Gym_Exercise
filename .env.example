# Copy to .env and adjust. All values are optional for local development.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# PostgreSQL
POSTGRES_DB=gymrec
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Recognition pipeline
RECOGNITION_INPUT_SIZE=640
RECOGNITION_SMOOTHING_WINDOW=8
RECOGNITION_MIN_CONFIDENCE=0.6
# set to false once the real models are active (no camera = no keypoints)
RECOGNITION_ALLOW_SIMULATION=true
